# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.log
.pytest_cache/
.coverage
htmlcov/

# Entorno virtual
.venv/
venv/
env/
ENV/

# Variables de entorno (usar .env.example como plantilla, sin secretos)
.env
.env.*
!.env.example

# Credenciales (reglas ESPECÍFICAS; no se usa una regla global *.json, que
# ocultaba la evidencia JSON de evaluation/results/)
google_credentials.json
*credentials*.json
*service-account*.json

# Modelos (archivos grandes; el hash de referencia está en docs/REPRODUCIBILIDAD.md)
*.pt
*.pth

# ── Datos DINÁMICOS: nunca en el repositorio ──────────────────────
# Con DATA_ROOT definido se escriben fuera del repositorio (ver app/storage.py).
# Estas reglas cubren las rutas históricas cuando DATA_ROOT no está definido.

# Archivos generados por el sistema de evaluación
test_results_json/
charts/
*.xlsx

# Dataset acumulado para fine-tuning (imágenes, etiquetas y metadatos subidos)
dataset/images/
dataset/labels/
dataset/finetune/
dataset/metadata/

# Métricas de producción (JSONL, crece con el uso)
metrics/
test_results/

# Datos de participantes y retroalimentación (información personal — nunca versionar)
study_data/
feedback_data/

# Copias comprimidas del proyecto (pueden incluir .env y datos personales)
*.zip

# Audio generado por TTS
audio_output/

# Imágenes anotadas generadas por el visualizador de detecciones
detections_output/

# Cache de librerías
*.cache
translation_cache.json

# IDEs
.vscode/
.idea/

# Sistema operativo
.DS_Store
Thumbs.db

# NOTA: stimuli/ (estímulos congelados de entrada, con hash verificado) SÍ se versiona.
