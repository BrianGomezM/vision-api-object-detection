# Plantilla de configuración. Copiar a .env y completar. No contiene secretos.
# Las variables que no aparecen aquí tienen valores por defecto en el código.

# ── Claves de servicios externos (obligatorias para la narrativa y la voz) ───
GROQ_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=canadacentral

# ── Perfil de ejecución (app/profiles.py) ────────────────────────────────────
# development: todos los endpoints y la documentación /docs (valor por defecto).
# study: evaluación controlada (detect, health y tts/models) con clave obligatoria.
# production: perfil del Dockerfile; detect, health, tts/models y métricas con clave.
APP_PROFILE=development

# Claves de acceso separadas por coma. Vacío = sin autenticación (solo desarrollo).
API_KEYS=
# Clave para consultar las métricas en el perfil production.
RESEARCHER_API_KEYS=
# Límite de solicitudes por clave y ventana de tiempo.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ── Carpeta de datos (app/storage.py) ────────────────────────────────────────
# Vacío = carpetas dentro del proyecto, ignoradas por Git.
# Definida = todo lo que el servicio escribe va a esa carpeta (ver docs/DATOS.md).
DATA_ROOT=

# ── Detector YOLO (app/services/yolo_service.py) ─────────────────────────────
YOLO_WEIGHTS=yolo26s.pt
YOLO_IMGSZ=1280
YOLO_IOU=0.45
# Si se define, el servicio no arranca cuando los pesos no coinciden con este SHA-256.
YOLO_WEIGHTS_SHA256=646f8bc3fe0a656803d95c294f7852321748cb29d13466a1af8862e2db384a1b
# Permite que Ultralytics descargue los pesos si faltan (true por defecto, salvo en study).
# YOLO_ALLOW_DOWNLOAD=false

# ── Modelo de lenguaje y voz ─────────────────────────────────────────────────
GROQ_MODEL=qwen/qwen3.8-27b

# Voz: Azure AI Speech, es-CO-SalomeNeural (claves arriba). Sin AZURE_SPEECH_KEY y
# AZURE_SPEECH_REGION la API responde solo con texto y /api/health lo informa.
# AZURE_TTS_RATE=-5%
# TTS_DEFAULT_MODEL=azure:es-CO-SalomeNeural

# ── Otros ────────────────────────────────────────────────────────────────────
# Sitios web autorizados para llamar a la API desde el navegador, separados por coma.
CORS_ORIGINS=
# Límite por IP en production: RATE_LIMIT_IP_REQUESTS=6, RATE_LIMIT_IP_WINDOW_S=60.
MAX_UPLOAD_MB=10
