# Plantilla de configuración — copiar a .env y completar. NO contiene secretos.
# Solo se listan las variables principales; el resto tiene valores por defecto en el código.

# ── Secretos (completar en .env local; nunca versionar ni poner en el cliente) ──
GROQ_API_KEY=
GOOGLE_API_KEY=
# Claves del investigador separadas por coma. Vacío = modo desarrollo SIN autenticación.
# El perfil study se niega a arrancar si está vacío.
API_KEYS=

# ── Perfil de la aplicación (app/profiles.py, app/main.py) ─────────────────
# development (defecto local): todos los endpoints, igual que antes.
# study: solo endpoints del investigador (detect, health, tts/models, study, catalog).
# production (perfil del Dockerfile): solo POST /api/detect y GET /api/health; sin /docs.
APP_PROFILE=development
# Límite de peticiones por clave y ventana. Con el perfil study TODAS las llamadas del
# investigador (catálogo, imágenes, sesiones, detección) comparten este límite: el valor
# por defecto (10/60 s) es bajo para una sesión — ajustar antes de usar el perfil study.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ── Datos dinámicos (app/storage.py) ─────────────────────────────────────────
# Vacío = rutas históricas dentro del repositorio (comportamiento anterior).
# Definido = todo lo que la app escribe va fuera del código, p. ej.:
# DATA_ROOT=D:/University/T2/Programacion/archivos
DATA_ROOT=

# ── YOLO (app/services/yolo_service.py) ─────────────────────────────────────
YOLO_WEIGHTS=yolo26s.pt
YOLO_IMGSZ=1280
YOLO_IOU=0.45
# Hash de los pesos usados en la tesis (docs/REPRODUCIBILIDAD.md). Si se define, el
# arranque falla cuando el archivo no coincide.
YOLO_WEIGHTS_SHA256=646f8bc3fe0a656803d95c294f7852321748cb29d13466a1af8862e2db384a1b
# ¿Permitir que Ultralytics descargue los pesos si faltan? Defecto: true en development,
# false en study. Con YOLO_WEIGHTS_SHA256 definido nunca se descargan pesos sin verificar.
# YOLO_ALLOW_DOWNLOAD=false

# ── LLM y TTS ────────────────────────────────────────────────────────────────
GROQ_MODEL=qwen/qwen3.8-27b
TTS_MODEL=models/gemini-3.1-flash-tts-preview
TTS_VOICE=Sulafat
# TTS_STYLE_INSTRUCTIONS=   (instrucción de estilo de voz; ver .env local)

# Azure AI Speech: voces alternativas SOLO para el módulo Detectar (el estudio y la
# evaluación usan siempre TTS_MODEL). Sin estas dos variables las voces no aparecen.
# AZURE_SPEECH_KEY=          (secreto: Clave 1 del recurso Speech)
# AZURE_SPEECH_REGION=canadacentral
# AZURE_TTS_RATE=-5%         (ritmo; por defecto -5 %)

# ── Otros ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=
# CORS_ORIGIN_REGEX=   (defecto: ^https://visionnav-client(-[a-zA-Z0-9]+)*.vercel.app$; acotar al equipo en producción)
# Límite por IP (production): RATE_LIMIT_IP_REQUESTS=6, RATE_LIMIT_IP_WINDOW_S=60,
# TRUSTED_PROXY_HOPS=0 (fijar tras verificar el proxy de la plataforma; ver docs/DEPLOYMENT.md §D)
MAX_UPLOAD_MB=10
