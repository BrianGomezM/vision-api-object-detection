# Secretos y config local — nunca deben entrar a la imagen
.env
.env.*
google_credentials.json
*credentials*.json
*service-account*.json

# Entornos virtuales y cachés de Python
.venv/
venv/
env/
ENV/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
*.log

# Git y CI
.git/
.github/

# Datos/artefactos generados en runtime (se regeneran, no hace falta hornearlos)
audio_output/
detections_output/
test_results/
test_results_json/
metrics/
charts/
data/
dataset/

# Datos personales de participantes y retroalimentación — nunca en la imagen
study_data/
feedback_data/

# Evidencia, scripts de análisis, pruebas y documentación (no se usan en runtime)
evaluation/
scripts/
tests/
docs/
README.md
pytest.ini
requirements-dev.txt
requirements.lock.txt
# (requirements-docker.lock.txt SÍ entra: lo usa el Dockerfile)

# Configuración de F4 (la usa el runner local, no el contenedor de producción)
experimental_config.yaml

# Código experimental no montado por app/main.py
app/experimental/

# Pesos: la imagen usa SOLO los descargados y verificados en el Dockerfile (ADD --checksum);
# un .pt local nunca debe entrar en la imagen.
*.pt
*.pth

# IDE
.vscode/
.idea/

# NO se excluyen (la app los necesita):
#   stimuli/          estímulos congelados servidos por /api/catalog
#   test_images/      imágenes de /api/test/* (perfil development)
#   app/catalog/      catálogo único de pruebas
